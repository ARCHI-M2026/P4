{
  "info": {
    "name": "DataShare API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "auth/register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.collectionVariables.set('test_email', `test+${Date.now()}@example.com`);",
              "pm.collectionVariables.set('test_password', 'Password123!');"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{test_email}}\",\"password\":\"{{test_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.access_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{test_email}}\",\"password\":\"{{test_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "file/Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('file_id', json.id);",
              "  pm.collectionVariables.set('download_token', json.downloadToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": [] },
            { "key": "expiresInDays", "value": "1", "type": "text" },
            { "key": "password", "value": "secret123", "type": "text" }
          ]
        },
        "url": {
          "raw": "http://localhost:3000/file",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["file"]
        }
      },
      "response": []
    },
    {
      "name": "file/List",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/file",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["file"]
        }
      },
      "response": []
    },
    {
      "name": "file/Delete",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/file/{{file_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["file", "{{file_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "file/ForceExpire (dev)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/file/{{file_id}}/force-expire",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["file", "{{file_id}}", "force-expire"]
        }
      },
      "response": []
    },
    {
      "name": "download/GetMetadata",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/download/{{download_token}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["download", "{{download_token}}"]
        }
      },
      "response": []
    },
    {
      "name": "download/GetUrl",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"password\":\"secret123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/download/{{download_token}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["download", "{{download_token}}"]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [""]
      }
    }
  ],
  "variable": [
    { "key": "test_email", "value": "" },
    { "key": "test_password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "file_id", "value": "" },
    { "key": "download_token", "value": "" }
  ]
}